<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shop Header with Dropdown</title>


  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

  <style>
    body {
      background-color: #f8f8cb;
      margin: 0;
      padding: 0;
    }
    .topbar {
      background: rgb(0, 96, 0);
      border-bottom: 5px solid #f0f72d;
      padding: 3px 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      position: sticky;
      top: 0;
      z-index: 60;
    }
    .brand-name {
      font-size: 45px;
      font-weight: bold;
      margin: 0;
      padding-left: 10px;
      color: #f7f6bb;
      text-shadow: 2px 2px 4px #fcdc2a;
      font-family: 'Baskerville', serif;
    }
    .search-box {
      flex: 1;
      width: 450px;
      margin: 0 5px;
      position: relative;
      left: -300px;
    }
    .search-box input {
      width: 100%;
      border-radius: 7px;
      border: none;
      padding: 12px 45px 12px 20px;
      font-size: 1rem;
      background-color: #f5f5f5;
      color: #333;
      box-shadow: inset 0 1px 4px rgba(0, 0, 0, 0.2);
      transition: all 0.3s ease;
    }
    .search-box input:focus {
      background-color: #ffffff;
      box-shadow: 0 0 5px #f0f72d;
    }
    .search-box i {
      position: absolute;
      right: 18px;
      top: 50%;
      transform: translateY(-50%);
      color: #666;
      cursor: pointer;
    }
    #accountDropdown::after {
      display: none;
    }
    .suggestions-box {
      position: absolute;
      background-color: #fff;
      border: 1px solid #ccc;
      max-height: 200px;
      overflow-y: auto;
      z-index: 1000;
      width: 100%;
      border-radius: 5px;
      display: none;
    }
    .suggestions-box div {
      padding: 10px;
      cursor: pointer;
    }
    .suggestions-box div:hover {
      background-color: #f0f72d;
    }
    
        @media (max-width: 992px) {
            .topbar img {
                height: 50px !important;
                width: 50px !important;
            }
            .brand-name {
                font-size: 30px;
            }
            .topbar {
                justify-content: baseline;
            }
            .search-box {
                max-width: 100%;
                margin: 10px 0;
            }
        }
  </style>
</head>

<body>
  <div class="topbar sticky-top">
    <div class="d-flex align-items-center">
      <img src="/css/images/icon/logo.png" alt="Chanchal Saree Logo" style="height:90px; width:100px;" />
      <span class="brand-name">Chanchal Saree</span>
    </div>

    <button class="btn btn-light border d-lg-none" type="button" data-bs-toggle="offcanvas"
      data-bs-target="#offcanvasHeader" aria-controls="offcanvasHeader" id="menu">
      <i class="bi bi-list"></i>
    </button>

    <div class="d-none d-lg-flex align-items-center">
      <button class="btn btn-light border d-flex align-items-center icon" type="button"
        data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar" id="all">
        <i class="bi bi-list me-2"></i> All
      </button>

      <div class="search-box me-3">
        <input type="text" id="searchInput" placeholder="Search for products..." />
        <i class="bi bi-search"></i>
        <div id="suggestions" class="suggestions-box"></div>
      </div>

      <div class="user-section d-flex align-items-center">
        <a href="#" class="d-flex align-items-center dropdown-toggle" id="accountDropdown"
          data-bs-toggle="dropdown" aria-expanded="false" style="text-decoration: none;">
          <i class="bi bi-person-circle me-2" style="font-size:1.5rem; position: relative; left: -30px; color: white;"></i>
          <span style="position: relative; left: -30px; color: white;"><%= currUser ? currUser.username : ' ' %></span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="accountDropdown">
          <% if(!currUser){ %>
          <li><a class="dropdown-item" href="/login">Profile</a></li>
          <% } else { %>
            <li><a class="dropdown-item" href="/profile">Profile</a></li>
          <% } %>
          <li><hr class="dropdown-divider"></li>
          <% if (!currUser) { %>
            <li><a class="dropdown-item" href="/signup">SignUp</a></li>
            <li><a class="dropdown-item" href="/login">Login</a></li>
          <% } else { %>
            <li><a class="dropdown-item" href="/logout">Logout</a></li>
          <% } %>
        </ul>

        <i class="bi bi-heart me-3" style="cursor: pointer; font-size:1.5rem; color: white; position: relative; left: -20px;"></i>

        <div class="position-relative">
          <i class="bi bi-cart3" data-bs-toggle="offcanvas" data-bs-target="#cartPanel"
            style="cursor: pointer; font-size:1.5rem; color: white; position: relative; left: -18px;">
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
              id="cartCount">0</span>
          </i>
        </div>
      </div>
    </div>

    <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
      <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="offcanvasNavbarLabel">Categories</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
      </div>
      <div class="offcanvas-body">
        <ul class="navbar-nav">
          <li class="nav-item"><a class="nav-link" href="/collectDetails?type=nexa">Nexa</a></li>
          <li class="nav-item"><a class="nav-link" href="/collectDetails?type=ruby">Ruby</a></li>
          <li class="nav-item"><a class="nav-link" href="/collectDetails?type=blackGold">Black Gold</a></li>
          <li class="nav-item"><a class="nav-link" href="/collectDetails?type=blueBell">Blue Bell</a></li>
          <li class="nav-item"><a class="nav-link" href="/collectDetails?type=rozy">Rozy</a></li>
          <li class="nav-item"><a class="nav-link" href="/collectDetails?type=raga">Raga</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasHeader" aria-labelledby="offcanvasHeaderLabel">
    <div class="offcanvas-header">
      <h5 class="offcanvas-title" id="offcanvasHeaderLabel">Menu</h5>
      <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
      <ul class="navbar-nav">
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Categories
          </a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="/collectDetails?type=nexa">Nexa</a></li>
            <li><a class="dropdown-item" href="/collectDetails?type=ruby">Ruby</a></li>
            <li><a class="dropdown-item" href="/collectDetails?type=blackGold">Black Gold</a></li>
            <li><a class="dropdown-item" href="/collectDetails?type=blueBell">Blue Bell</a></li>
            <li><a class="dropdown-item" href="/collectDetails?type=rozy">Rozy</a></li>
            <li><a class="dropdown-item" href="/collectDetails?type=raga">Raga</a></li>
          </ul>
        </li>
      </ul>
      <div class="user-section d-flex flex-column align-items-start" style="color: black;">
        <div class="dropdown mb-2">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Account
          </a>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="/profile">Profile</a></li>
            <li><hr class="dropdown-divider"></li>
            <% if (!currUser) { %>
              <li><a class="dropdown-item" href="/signup">SignUp</a></li>
              <li><a class="dropdown-item" href="/login">Login</a></li>
            <% } else { %>
              <li><a class="dropdown-item" href="/logout">Logout</a></li>
            <% } %>
          </ul>
        </div>

        <i class="bi bi-heart mb-2" style="cursor: pointer; font-size:1rem;"> Like</i>
        <div style="position: relative;">
          <i class="bi bi-cart3" data-bs-toggle="offcanvas" data-bs-target="#cartPanel"
            style="cursor: pointer; font-size:1rem;">
            Order
          </i>
        </div>
      </div>
    </div>
  </div>

  <div class="offcanvas offcanvas-end" tabindex="-1" id="cartPanel" aria-labelledby="cartPanelLabel">
    <div class="offcanvas-header">
      <h5 class="offcanvas-title" id="cartPanelLabel">Your Orders</h5>
      <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
      <ul id="cartItems" class="list-group"></ul>
      <hr />
      <div class="d-flex justify-content-between align-items-center">
        <strong>Total:</strong>
        <span id="cartTotal">₹0</span>
      </div>
      <button class="btn btn-success w-100 mt-3 checkOut"  style="background-color:green;" onclick="deleteItem('${item.name}')">Checkout</button>
      <button class="btn btn-danger w-100 mt-2" id="clearCart" style="background-color:red;">Clear Cart</button>
    </div>
    <p style="text-align: center; background-color: #f0f72d; color: green; padding: 15px; font-size: 20px;">Cash on delivery only</p>
  </div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
document.addEventListener("DOMContentLoaded", function () {

  const cartCountEl = document.getElementById("cartCount");
  const cartItemsUl = document.getElementById("cartItems");
  const cartTotalEl = document.getElementById("cartTotal");
  const clearCartBtn = document.getElementById("clearCart");


  const username = "<%= currUser ? currUser.username : '' %>";
  const cartKey = username ? `cart_${username}` : 'cart_guest';


  function getCartItems() {
    return JSON.parse(localStorage.getItem(cartKey)) || [];
  }

  function setCartItems(items) {
    localStorage.setItem(cartKey, JSON.stringify(items));
  }

 
  function updateCartCount() {
    const items = getCartItems();
    cartCountEl.textContent = items.length;
  }


  function renderCart() {
    const items = getCartItems();
    cartItemsUl.innerHTML = "";
    let totalPrice = 0;

    if (items.length === 0) {
      const li = document.createElement("li");
      li.classList.add("list-group-item", "text-center");
      li.textContent = "Cart is empty";
      cartItemsUl.appendChild(li);
    } else {
      items.forEach(item => {
        const li = document.createElement("li");
        li.classList.add("list-group-item", "d-flex", "justify-content-between", "align-items-center");
        li.innerHTML = `
          <div>${item.name}</div>
          <div>
            <button class="btn btn-sm btn-danger" onclick="updateQuantity('${item.name}', -1)" style="background-color:red;">−</button>
            <span class="mx-2">${item.quantity}</span>
            <button class="btn btn-sm btn-success" onclick="updateQuantity('${item.name}', 1)" style="background-color:green;">+</button>
            <span class="ms-3">₹${item.price * item.quantity}</span>
            <button type="button" class="btn btn-sm btn-danger ms-2" onclick="deleteItem('${item.name}')" style="background-color:red;">
              <i class="bi bi-trash"></i>
            </button>
          </div>
        `;
        cartItemsUl.appendChild(li);
        totalPrice += item.price * item.quantity;
      });
    }
    cartTotalEl.textContent = "₹" + totalPrice;
    
  }


  window.updateQuantity = function (name, delta) {
    const items = getCartItems();
    const idx = items.findIndex(i => i.name === name);
    if (idx > -1) {
      items[idx].quantity += delta;
      if (items[idx].quantity <= 0) items.splice(idx, 1);
      setCartItems(items);
      renderCart();
      updateCartCount();
    }
  }


  window.deleteItem = function (name) {
    let items = getCartItems();
    items = items.filter(i => i.name !== name);
    setCartItems(items);
    renderCart();
    updateCartCount();
  }

  
  clearCartBtn.onclick = function () {
    setCartItems([]);
    renderCart();
    updateCartCount();
  }

 
  window.goToCart = function (name, price, imageUrl) {
    const items = getCartItems();
    const existing = items.find(i => i.name === name);
    if (existing) {
      existing.quantity += 1;
    } else {
      items.push({ name, price, imageUrl, quantity: 1 });
    }
    setCartItems(items);
    updateCartCount();
  }


  const products = [
    { name: "nexa saree", url: "/collectDetails?type=nexa" },
    { name: "ruby Saree", url: "/collectDetails?type=ruby" },
    { name: "rozy Saree", url: "/collectDetails?type=rozy" },
    { name: "blackgold Saree", url: "/collectDetails?type=blackGold" },
    { name: "blueBell Saree", url: "/collectDetails?type=blueBell" },
    { name: "raga Saree", url: "/collectDetails?type=raga" }
  ];

  const searchInput = document.getElementById("searchInput");
  const suggestionsBox = document.getElementById("suggestions");

  searchInput.addEventListener("input", function () {
    const input = this.value.toLowerCase();
    suggestionsBox.innerHTML = "";
    suggestionsBox.style.display = "none";
    if (input) {
      const filtered = products.filter(p => p.name.toLowerCase().includes(input));
      if (filtered.length > 0) {
        filtered.forEach(p => {
          const div = document.createElement("div");
          div.textContent = p.name;
          div.onclick = () => window.location.href = p.url;
          suggestionsBox.appendChild(div);
        });
        suggestionsBox.style.display = "block";
      }
    }
  });

  document.addEventListener("click", function (e) {
    if (!searchInput.contains(e.target) && !suggestionsBox.contains(e.target)) {
      suggestionsBox.style.display = "none";
    }
  });

 
  const checkOutBtn = document.querySelector('.checkOut');
  checkOutBtn.addEventListener('click', () => {
    const items = getCartItems();
    if(items.length == 0){
      alert("please buy product");
    } else {
window.location.href = '/checkOut';
    }
    
  });
  


  renderCart();
  updateCartCount();
});
</script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
   <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</body>
</html>
