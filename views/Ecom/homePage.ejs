<% layout('layouts/boilerplate') %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Web Project</title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

  <style>
    .contain {
      position: relative;
      height: 45rem !important;
      background-image: url('/css/images/back.png');
      background-size: cover;
      background-position: center;
      overflow: hidden;
    }

    .img {
      position: absolute;
      left: -170px;
      top: 0;
      width: 60vw;
      height: 100%;
      object-fit: cover;
      max-width: 800px;
      max-height: 100%;
    }

    .text-block {
      position: absolute;
      left: 300px;
      top: 30%;
      max-width: 550px;
      background: rgba(224, 239, 224, 0.8);
      padding: 20px 25px;
      border-radius: 10px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
      z-index: 10;
      color: #333;
    }
    .text-block h2 {
      font-size: 1.8rem;
      margin-bottom: 10px;
    }
    .text-block p#two {
      font-size: 1.2rem;
      margin-bottom: 15px;
    }
    .text-block h1.one.three {
      font-size: 2.5rem;
      margin-bottom: 20px;
      line-height: 1.2;
    }
    .text-block button {
      padding: 10px 20px;
      font-size: 1rem;
      color: white;
      background-color: green;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      transition: background-color 0.3s ease;
    }
    .text-block button:hover {
      background-color: darkgreen;
    }

    .slideshow-container {
      position: absolute;
      top: 25px;
      right: 40px;
      width: 35%;
      max-width: 400px;
      height: calc(100% - 50px);
      max-height: 650px;
      overflow: hidden;
      z-index: 5;
      border-radius: 10px;
    }
    .slides {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: none;
      position: absolute;
      top: 0;
      left: 0;
      animation: fadeEffect 1s ease-in-out;
    }
    .dots {
      position: absolute;
      bottom: 10px;
      width: 100%;
      text-align: center;
      z-index: 10;
    }
    .dot {
      height: 10px;
      width: 10px;
      margin: 0 4px;
      background-color: #bbb;
      border-radius: 50%;
      display: inline-block;
      transition: background-color 0.3s ease;
      cursor: pointer;
    }
    .dot.active {
      background-color: #333;
    }
    @keyframes fadeEffect {
      from { opacity: 0.3; }
      to { opacity: 1; }
    }
    .card{
        border: 0px solid black;
        padding:0px 100px 0px 0px ;
        display: inline-block;
        text-align: center;
    }

    .card .card-img-top {
      width: 200px;
      max-height: 200px;
      object-fit: cover;
      border-radius: 50%;
    }
    .card .card-title {
      padding-top: 10px;
      color: #000;
    }
    .card a{
        text-decoration: none;
        display: inline-block;
        padding-left: 100px;
        padding-top: 40px;
        padding-bottom: 20px;
    }

    @media (max-width: 1200px) {
      .text-block {
        left: 30px;
        top: 25%;
        max-width: 300px;
      }
      .slideshow-container {
        width: 300px;
        right: 20px;
        top: 20px;
        height: auto;
        max-height: 400px;
      }
    }
    @media (max-width: 768px) {
      .text-block {
        position: static;
        margin: 20px auto;
        background: rgba(255, 255, 255, 0.95);
        padding: 15px;
        max-width: 90%;
      }
      .slideshow-container {
        position: relative;
        width: 90%;
        max-height: 50vh;
        margin: 0 auto 20px auto;
      }
    }

    footer {
      background-color: #ebebeb;
    }
    footer .socials i {
      font-size: 1.2rem;
      margin-right: 1rem;
    }
    footer .links a {
      text-decoration: none;
      color: #222222;
    }
    footer .links a:hover {
      text-decoration: underline;
    }
   
  </style>
</head>
<body>

  <div class="contain">
    <img src="/css/images/bg2.png" alt="Background side" class="img">

    <div class="text-block">
      <h2 id="h2">Looking Gorgeous?</h2>
      <p id="two">Don’t Wait!</p>
      <h1 class="one three">Let’s Pick Your Saree Now :)</h1>
      <form action="/collection" method="GET">
        <button type="submit" id="collect">Check Our Collection</button>
      </form>
    </div>

    <div class="slideshow-container">
      <img class="slides" src="/css/images/blackGold/blackGold.jpg" alt="Slide 1">
      <img class="slides" src="/css/images/blueBell/blueBell.jpg" alt="Slide 2">
      <img class="slides" src="/css/images/ruby/ruby.jpg" alt="Slide 3">
      <img class="slides" src="/css/images/raga/raga.jpg" alt="Slide 4">
      <img class="slides" src="/css/images/rozy/rozy.jpg" alt="Slide 5">
      <div class="dots">
        <span class="dot" data-index="1"></span>
        <span class="dot" data-index="2"></span>
        <span class="dot" data-index="3"></span>
        <span class="dot" data-index="4"></span>
        <span class="dot" data-index="5"></span>
      </div>
    </div>
  </div>
   <h1 style="text-align: center; padding-top: 20px !important;">Our Collections</h1>
        <div class="card" target="_blank">
          <a href="/collectDetails?type=blackGold" >
            <img src="/css/images/blackGold/blackGold.jpg"
                 class="card-img-top"
                 alt="Black Gold">
            <h5 class="card-title">Black Gold</h5>
          </a>
          <a href="/collectDetails?type=blueBell">
            <img src="/css/images/blueBell/blueBell.jpg"
                 class="card-img-top"
                 alt="Blue Bell">
            <h5 class="card-title">Blue Bell</h5>
          </a>
          <a href="/collectDetails?type=nexa">
            <img src="/css/images/nexa/nexa.jpg"
                 class="card-img-top"
                 alt="Nexa">
            <h5 class="card-title">Nexa</h5>
          </a>
          <a href="/collectDetails?type=raga">
            <img src="/css/images/raga/Raga.jpg"
                 class="card-img-top"
                 alt="Raga">
            <h5 class="card-title">Raga</h5>
          </a>
          <a href="/collectDetails?type=rozy">
            <img src="/css/images/rozy/rozy.jpg"
                 class="card-img-top"
                 alt="Rozy">
            <h5 class="card-title">Rozy</h5>
          </a>
          <a href="/collectDetails?type=ruby">
            <img src="/css/images/ruby/ruby.jpg"
                 class="card-img-top"
                 alt="Ruby">
            <h5 class="card-title">Ruby</h5>
          </a>
          <a href="">
            <img src="/css/images/blackGold/blackGold.jpg"
                 class="card-img-top"
                 alt="Black Gold">
            <h5 class="card-title">Black Gold</h5>
          </a>
          <a href="">
            <img src="/css/images/blackGold/blackGold.jpg"
                 class="card-img-top"
                 alt="Black Gold">
            <h5 class="card-title">Black Gold</h5>
          </a>
        </div>
  <footer class="bg-light py-3 mt-auto">
    <div class="container text-center">
      <div class="socials mb-2">
        <i class="fa-brands fa-facebook me-3"></i>
        <i class="fa-brands fa-instagram me-3"></i>
        <i class="fa-brands fa-linkedin me-3"></i>
      </div>
      <div class="Brands mb-2">&copy; 2025 Chanchal Saree Private Limited</div>
      <div class="links">
        <a href="#" class="me-3">Privacy</a>
        <a href="#">Terms</a>
      </div>
    </div>
  </footer>

  <!-- Bootstrap JS bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    let slideIndex = 0;
    const slides = document.getElementsByClassName("slides");
    const dots = document.getElementsByClassName("dot");

    function showSlides() {
      for (let i = 0; i < slides.length; i++) {
        slides[i].style.display = "none";
      }
      slideIndex++;
      if (slideIndex > slides.length) slideIndex = 1;

      for (let i = 0; i < dots.length; i++) {
        dots[i].classList.remove("active");
      }
      slides[slideIndex - 1].style.display = "block";
      dots[slideIndex - 1].classList.add("active");

      setTimeout(showSlides, 3000);
    }

    window.onload = showSlides;

    Array.from(dots).forEach(dot => {
      dot.addEventListener("click", () => {
        const idx = parseInt(dot.getAttribute("data-index"));
        if (!isNaN(idx)) {
          slideIndex = idx - 1;
          showSlides();
        }
      });
    });
  </script>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
