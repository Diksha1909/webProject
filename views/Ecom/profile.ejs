<% layout('layouts/boilerplate') %>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>User Profile - Chanchal Saree</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
<style>
body { font-family: "Poppins", sans-serif; background-color: #f8f9fa; }
.main-container { display: flex; justify-content: flex-start; padding: 50px 80px; gap: 40px; }
/* Sidebar */
.profile-card { width: 300px; background: #fff; border-radius: 15px; box-shadow: 0 4px 20px rgba(0,0,0,0.1); text-align: center; padding: 25px; }
#i { height: 90px; width: 90px; background: #bf3e3e; color: white; font-size: 50px; font-weight: bold; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 10px; }
.detail p { margin: 2px 0; font-size: 16px; }
.anchor a { display: block; text-decoration: none; color: #333; font-size: 17px; margin: 12px 0; transition: color 0.2s ease; cursor:pointer; }
.anchor a:hover { color: #bf3e3e; }
/* Right side content */
.content-area { flex: 1; background: #fff; border-radius: 15px; box-shadow: 0 4px 20px rgba(0,0,0,0.1); padding: 30px; min-height: 400px; }
form .mb-3 { margin-bottom: 15px; }
</style>
</head>
<body>

<div class="main-container">
  <!-- LEFT SIDE: Sidebar -->
  <div class="profile-card">
    <div id="i"><%= currUser.username.charAt(0).toUpperCase() %></div>
    <div class="detail">
      <p><strong><%= currUser.username %></strong></p>
      <p><%= currUser.emailId %></p>
    </div>
    <hr>
    <div class="anchor text-start">
      <a data-page="my-profile"><i class="fa-solid fa-user"></i> My Profile</a>
      <a data-page="update-password"><i class="fa-solid fa-lock"></i> Update Password</a>
      <a data-page="update-mobile"><i class="fa-solid fa-phone"></i> Update Mobile Number</a>
      <a data-page="address"><i class="fa-solid fa-location-dot"></i> Manage Address</a>
      <a data-page="orders"><i class="fa-solid fa-list-check"></i> My Orders</a>
      <a data-page="track"><i class="fa-solid fa-truck"></i> Track My Order</a>
      <a href="/logout"><i class="bi bi-box-arrow-left"></i> Logout</a>
    </div>
  </div>

  <!-- RIGHT SIDE: Content -->
  <div class="content-area" id="contentArea">
    <h3>👤 My Profile</h3>
    <p><b>Name:</b> <%= currUser.username %></p>
    <p><b>Email:</b> <%= currUser.emailId %></p>
    <p><b>Mobile:</b> <%= currUser.phone_no || 'Not added' %></p>
    <p><b>Address:</b> <%= currUser.Address || 'Not added yet' %></p>
  </div>
</div>

<script>
let user = {
  id: "<%= currUser._id %>",
  username: "<%= currUser.username %>",
  emailId: "<%= currUser.emailId %>",
  phone_no: "<%= currUser.phone_no || '' %>",
  addresses: "<%-JSON.stringify(currUser.Address ? [currUser.Address] : []) %>",
  cart: "<%- JSON.stringify(currUser.cart || []) %>" // assuming cart is an array of items
};

// Templates
function renderProfile() {
  return `
    <h3>👤 My Profile</h3>
    <p><b>Name:</b> ${user.username}</p>
    <p><b>Email:</b> ${user.emailId}</p>
    <p><b>Mobile:</b> ${user.phone_no || 'Not added'}</p>
    <p><b>Address:</b> ${user.addresses.length ? user.addresses.join(', ') : 'Not added yet'}</p>
  `;
}

function renderUpdatePassword() {
  return `
    <h3>🔒 Update Password</h3>
    <form id="passwordForm">
      <div class="mb-3"><label>Current Password</label><input type="password" class="form-control" name="currentPassword" required></div>
      <div class="mb-3"><label>New Password</label><input type="password" class="form-control" name="newPassword" required></div>
      <div class="mb-3"><label>Confirm New Password</label><input type="password" class="form-control" name="confirmPassword" required></div>
      <button class="btn btn-danger" type="submit">Update Password</button>
    </form>
  `;
}

function renderUpdateMobile() {
  return `
    <h3>📱 Update Mobile Number</h3>
    <form id="mobileForm">
      <div class="mb-3"><label>New Mobile Number</label><input type="text" class="form-control" name="mobile" maxlength="10" required></div>
      <button class="btn btn-danger" type="submit">Update</button>
    </form>
  `;
}

function renderAddress() {
  return `
    <h3>🏠 Manage Address</h3>
    <div id="addressList">
      ${user.addresses.length ? user.addresses.map(a=>`<p>${a}</p>`).join('') : '<p>No addresses added yet.</p>'}
    </div>
    <form id="addressForm">
      <div class="mb-3">
        <label>New Address</label>
        <textarea class="form-control" name="newAddress" rows="2" required></textarea>
      </div>
      <button class="btn btn-danger" type="submit">Add Address</button>
    </form>
  `;
}

function renderOrders() {
  return `
    <h3>🧾 My Orders</h3>
    ${user.cart.length ? user.cart.map(item=>`<p>${item.name} - ${item.quantity}</p>`).join('') : '<p>No orders in cart.</p>'}
  `;
}

function renderTrack() {
  return `
    <h3>🚚 Track My Order</h3>
    <form id="trackForm">
      <div class="mb-3"><label>Enter Order ID</label><input type="text" class="form-control" name="orderId" required></div>
      <button class="btn btn-danger" type="submit">Track</button>
    </form>
  `;
}

// Sidebar clicks
document.querySelectorAll('.anchor a[data-page]').forEach(link => {
  link.addEventListener('click', e => {
    e.preventDefault();
    const page = link.getAttribute('data-page');
    let contentHTML = '';
    if(page==='my-profile') contentHTML = renderProfile();
    else if(page==='update-password') contentHTML = renderUpdatePassword();
    else if(page==='update-mobile') contentHTML = renderUpdateMobile();
    else if(page==='address') contentHTML = renderAddress();
    else if(page==='orders') contentHTML = renderOrders();
    else if(page==='track') contentHTML = renderTrack();

    document.getElementById('contentArea').innerHTML = contentHTML;

    // Forms
    if(page==='update-mobile'){
      document.getElementById('mobileForm').addEventListener('submit', async function(ev){
        ev.preventDefault();
        const val = this.mobile.value.trim();
        if(val){
          const res = await fetch('/update-mobile', {
            method:'POST',
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({mobile:val})
          });
          const data = await res.json();
          if(data.success){ user.phone_no = val; alert('Mobile updated!'); this.reset(); }
        }
      });
    }

    if(page==='address'){
      document.getElementById('addressForm').addEventListener('submit', async function(ev){
        ev.preventDefault();
        const val = this.newAddress.value.trim();
        if(val){
          const res = await fetch('/add-address', {
            method:'POST',
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({address:val})
          });
          const data = await res.json();
          if(data.success){ user.addresses.push(val); alert('Address added!'); this.reset(); document.getElementById('contentArea').innerHTML = renderAddress(); }
        }
      });
    }

    if(page==='update-password'){
      document.getElementById('passwordForm').addEventListener('submit', async function(ev){
        ev.preventDefault();
        const current = this.currentPassword.value;
        const newP = this.newPassword.value;
        const confirmP = this.confirmPassword.value;
        if(newP !== confirmP){ alert('Passwords do not match!'); return; }
        const res = await fetch('/update-password', {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify({currentPassword:current, newPassword:newP})
        });
        const data = await res.json();
        alert(data.message);
        if(data.success) this.reset();
      });
    }

  });
});
</script>
</body>
</html>
