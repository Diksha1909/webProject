<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Checkout</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { font-family: 'Arial', sans-serif; background-color: #f8f9fa; }
    .container { margin-top: 30px; display: flex; }
    .address-list, .order-summary { width: 40%; margin-right: 20px; }
    .address-item { border: 1px solid #ccc; border-radius: 5px; padding: 10px; margin-bottom: 10px; }
    .btn-custom { background-color: #28a745; color: white; }
    .btn-custom:hover { background-color: #218838; }
    .hidden { display: none; }
    .form-control { border-radius: 5px; }
    .total { font-weight: bold; }
  </style>
</head>
<body>

<div class="container">
  <!-- Address Selection -->
  <div class="address-list" id="addressList">
    <h2>Select Delivery Address</h2>
    <% if (currUser) { %>
      <div class="address-item">
        <h5><%= currUser.username %></h5>
        <p><%= currUser.Address %><br>Phone: <%= currUser.phone_no ? '+91 ' + currUser.phone_no : 'Not provided' %></p>
        <form action="/edit-address" method="POST">
          <input type="hidden" name="name" value="<%= currUser.username %>">
          <input type="hidden" name="address" value="<%= currUser.Address %>">
          <input type="hidden" name="phone" value="<%= currUser.phone_no %>">
          <button type="submit" class="btn btn-link">Edit</button>
        </form>
      </div>
    <% } else { %>
      <p>No address available.</p>
    <% } %>
    <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addAddressModal">+ ADD NEW ADDRESS</button>
  </div>

  <!-- Order Summary -->
  <div class="order-summary" id="orderSummary">
    <h2>Your Order</h2>
    <ul id="orderItems">
      <% cartItems.forEach(item => { %>
        <li><%= item.itemName %> - ₹<%= item.price.toFixed(2) %></li>
      <% }); %>
    </ul>
    <h4 class="total">Total: ₹<%= cartItems.reduce((total, item) => total + item.price, 0).toFixed(2) %></h4>
    <button class="btn btn-custom" id="checkoutBtn">Checkout</button>
  </div>
</div>

<!-- Add New Address Modal -->
<div class="modal fade" id="addAddressModal" tabindex="-1" aria-labelledby="addAddressModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="addAddressModalLabel">Add New Address</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/add-address" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label for="name" class="form-label">Name</label>
            <input type="text" class="form-control" id="name" name="name" required>
          </div>
          <div class="mb-3">
            <label for="address" class="form-label">Address</label>
            <textarea class="form-control" id="address" name="address" rows="3" required></textarea>
          </div>
          <div class="mb-3">
            <label for="phone" class="form-label">Phone</label>
            <input type="tel" class="form-control" id="phone" name="phone" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="submit" class="btn btn-primary">Save Address</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Confirmation Message -->
<div class="container hidden" id="confirmationMessage">
  <h2>Order Placed Successfully!</h2>
  <p>Thank you for your order, <span id="customerName"><%= currUser.username %></span>! You will receive a confirmation shortly.</p>
  <button class="btn btn-primary" onclick="location.href='/my-orders'">Go to My Orders</button>
</div>

<script>
  document.getElementById('checkoutBtn').addEventListener('click', () => {
    const buyerName = '<%= currUser.username %>';
    document.getElementById('customerName').innerText = buyerName;
    document.querySelector('.container').classList.add('hidden');
    document.getElementById('confirmationMessage').classList.remove('hidden');
  });
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
