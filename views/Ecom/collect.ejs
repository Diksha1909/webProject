
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Collection Page</title>
  <style>
    #container {
      height: auto;
      max-width: 1000px;
      background-color: rgb(236, 232, 225);
      padding: 20px;
      border-radius: 10px;
      margin: 100px auto 0;
      box-sizing: border-box;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 15px;
      text-align: center;
    }

    .saree {
      background-color: whitesmoke;
      padding: 15px;
      border-radius: 10px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      transition: transform 0.3s ease;
    }

    .saree:hover {
      transform: translateY(-5px);
    }

    .saree img {
      border-radius: 10px;
      height: 140px;
      width: 170px;
      object-fit: cover;
      margin-bottom: 10px;
    }

    .saree p {
      margin-top: 5px;
      padding: 10px;
      font-size: 16px;
      color: #333;
    }

    .btn {
      background-color: #f0f0f0;
      border: 1px solid #ccc;
      border-radius: 5px;
      padding: 5px 10px;
      cursor: pointer;
      font-size: 16px;
      transition: background-color 0.3s ease;
    }

    .btn:hover {
      background-color: #ddd;
    }
  </style>
</head>
<body>
  <!-- include a partial for the homepage header/navigation etc. -->
  <%- include('homePage', { type: type, sareeDetails: sareeDetails }) %>

  <% const sareeData = sareeDetails && sareeDetails[type]; %>
  <% if (sareeData && Array.isArray(sareeData) && sareeData.length > 0) { %>
    <div id="container">
      <% sareeData.forEach(saree => { %>
        <div class="saree">
          <form method="POST" action="/addItem"> <!-- or whatever your add-item action is -->
            <!-- Adjust the image src path as per how your files are stored/served -->
            <img src="/css/images/<%= saree.image.fileName %>/<%= saree.image.url %>" 
                 alt="<%= saree.itemName %>">
            <p>
              <%= saree.itemName %><br>₹ <%= saree.price %>
            </p>
            <button type="submit" class="btn">Add item</button>
          </form>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <p style="text-align:center; margin-top: 50px;">No collection found in this category.</p>
  <% } %>
</body>
</html>
